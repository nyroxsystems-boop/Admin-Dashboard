# Admin Dashboard — environment variables
#
# Copy to `.env.local` and fill in for development.
# All VITE_* variables are inlined at build time and exposed to the browser
# bundle — never put secrets here.

# ── Required ────────────────────────────────────────────────────────────
# Required: Backend WWS-Service URL. NO trailing slash.
# Loud failure if missing — there is no production fallback in code.
VITE_API_BASE_URL=http://localhost:10000

# Required: Partslink24/OEM Scraper Microservice URL.
# Loud failure if missing — there is no production fallback in code.
VITE_SCRAPER_BASE_URL=http://localhost:4100

# ── Optional ────────────────────────────────────────────────────────────
# Optional: Sentry Error Tracking (leer = disabled in dev/prod).
VITE_SENTRY_DSN=

# Optional: Default i18n Locale on first visit (de | en | fr | es | it | pl | tr).
VITE_DEFAULT_LOCALE=de

# Optional: App version, surfaced in Sentry releases and the UI footer.
VITE_APP_VERSION=2.0.0
